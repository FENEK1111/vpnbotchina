# Telegram бот для Steam аккаунтов (Китай)
TELEGRAM_BOT_TOKEN=your_token_here
ADMIN_ID=123456789
DEBUG=True

# БД
DATABASE_URL=sqlite:///./vpn_bot_china.db

# Marzban VPN сервер
MARZBAN_URL=http://your_marzban_url:8000
MARZBAN_ADMIN_TOKEN=your_marzban_token

# Alipay инструкции
ALIPAY_ENABLED=True
ALIPAY_AMOUNT_OPTIONS=30,50,100,150,200

# VPN параметры
VPN_PRICE_PER_DAY_CNY=5
VPN_MAX_DEVICES=6
VPN_NOTIFICATION_DAYS=3

